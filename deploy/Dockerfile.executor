# 执行服务消费按清单同步的独立 flow-source，不复用配置表单的页面产物。
FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN npm install -g pnpm@10.25.0
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY web/package.json ./web/package.json
COPY form-runtime/package.json ./form-runtime/package.json
COPY executor-service/package.json ./executor-service/package.json
RUN pnpm install --frozen-lockfile --filter test-auto-pro-v2-executor-service
COPY executor-service ./executor-service
# 长连接下载曾中断；保留已校验的 npm 缓存并有限重试，失败仍阻止发布切换。
# 上游 Webpack 4 在 Node 22 下使用 OpenSSL 3 禁用的旧 hash，仅为本镜像构建进程启用兼容 provider。
RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    for attempt in 1 2 3; do \
      NODE_OPTIONS=--openssl-legacy-provider npm_config_fetch_retries=5 pnpm --dir executor-service build-native-page && exit 0; \
      [ "$attempt" != 3 ] || exit 1; \
      sleep 5; \
    done
# 原生页构建完成后依赖不再用于运行；保留源码摘要和产物，使启动检查保持幂等。
RUN rm -rf executor-service/flow-source/node_modules executor-service/node_modules

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
RUN npm install -g pnpm@10.25.0
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY web/package.json ./web/package.json
COPY form-runtime/package.json ./form-runtime/package.json
COPY executor-service/package.json ./executor-service/package.json
RUN pnpm install --frozen-lockfile --prod --filter test-auto-pro-v2-executor-service
# 内网发布的下载链路可能抖动；缓存已校验的包并重试，浏览器下载失败不重装系统依赖。
ARG DEBIAN_MIRROR=http://deb.debian.org/debian
ARG DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    printf 'Acquire::Retries "5";\n' >/etc/apt/apt.conf.d/80-retries \
    && rm -f /etc/apt/apt.conf.d/docker-clean \
    && sed -i "s|http://deb.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g; s|http://deb.debian.org/debian$|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
    && pnpm --dir executor-service exec playwright install-deps chromium
# 服务始终无头，安装与默认 launch 对应的 headless shell 即可。
RUN pnpm --dir executor-service exec playwright install chromium --only-shell
COPY --from=build /app/executor-service /app/executor-service
ENV EXECUTOR_DISABLE_AUTO_SYNC=1
WORKDIR /app/executor-service
EXPOSE 19011
CMD ["node", "--experimental-strip-types", "src/server.ts"]
