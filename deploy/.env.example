# 复制为项目根目录被 Git 忽略的本机配置（如 .env.compose），填入真实值后再启动。
# 任何真实凭证不进仓库、不进镜像层、不进 health 响应。

# 目标平台（必需；缺任一项后端拒绝启动）
TARGET_API_GATEWAY=
TARGET_LOGIN_PASSWORD=
TARGET_LOGIN_AES_KEY=
TARGET_LOGIN_CODE=
TARGET_PLATFORM_CODE=200001
TARGET_TEMPLATE_PLATFORM_CODES=200001,999999

# 工具库 MySQL（Compose 内网服务名固定为 mysql）
PLAN_DB_NAME=test_auto_pro_v2
PLAN_DB_USER=test_auto_pro
PLAN_DB_PASSWORD=
PLAN_DB_ROOT_PASSWORD=

# 端口映射（与本机约定一致）
WEB_PORT=19000
BACKEND_PORT=19080
FORM_RUNTIME_PORT=19001
CODE_SERVER_PORT=19002

# 运行时维护健康地址（容器网络内）
FORM_RUNTIME_HEALTH_URL=http://form-runtime:19001/

# 日志保留天数
LOG_RETENTION_DAYS=7

# code-server 运行 UID（与宿主用户一致，避免日志文件属主漂移）
CODE_SERVER_UID=1000
