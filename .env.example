# F-002 目标平台配置示例。这里只列变量名，不得提交真实值。

# 必需：目标平台网关 base URL。
TARGET_API_GATEWAY=

# 必需且敏感：仅由 Go 后端运行环境提供。
TARGET_LOGIN_PASSWORD=
TARGET_LOGIN_AES_KEY=
TARGET_LOGIN_CODE=

# 可选且非敏感：未设置时沿用已批准的 V1 约定。
TARGET_PLATFORM_CODE=
TARGET_TEMPLATE_PLATFORM_CODES=
TARGET_CUSTOMER_CODE=

# 可选：Go duration（如 30m）或正整数秒数。
TARGET_SESSION_TTL=
TARGET_HTTP_TIMEOUT=
