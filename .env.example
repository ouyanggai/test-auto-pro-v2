# F-002 目标平台配置键名示例。这里只列变量名，不得提交真实值。
# 日常本机开发自动读取被 Git 忽略的 .env.local；进程环境同名变量优先。
# 当前工作区已经准备完成，不需要复制本文件或手工填写。

# 必需：目标平台网关 base URL。
TARGET_API_GATEWAY=

# 必需且敏感：只允许存在于 Go 后端进程环境或本机忽略配置。
TARGET_LOGIN_PASSWORD=
TARGET_LOGIN_AES_KEY=
TARGET_LOGIN_CODE=

# 可选且非敏感：未设置时沿用已批准的 V1 约定。
TARGET_PLATFORM_CODE=
TARGET_TEMPLATE_PLATFORM_CODES=
TARGET_CUSTOMER_CODE=

# 可选：Go duration（如 30m）或正整数秒数。
TARGET_SESSION_TTL=
TARGET_HTTP_TIMEOUT=
