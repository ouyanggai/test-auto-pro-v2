{
  "name": "test-auto-pro-v2-form-runtime",
  "private": true,
  "version": "0.2.0",
  "description": "由完整 rsh-flow-components 源码驱动的独立表单渲染服务",
  "scripts": {
    "dev": "vue-cli-service serve --host 127.0.0.1 --port 19001",
    "build": "vue-cli-service build",
    "sync": "node scripts/sync.js",
    "sync:check": "node scripts/sync-check.js",
    "typecheck": "node --check src/main.js && node --check src/runtime/protocol.js && node --check src/runtime/formTemplate.js && node --check src/runtime/requestPolicy.js && node --check src/runtime/memoryAuth.js && node --check scripts/sync-config.js && node --check scripts/sync.js && node --check scripts/sync-check.js"
  },
  "dependencies": {
    "@wangeditor/editor": "5.1.23",
    "@wangeditor/editor-for-vue": "1.0.2",
    "axios": "0.20.0",
    "core-js": "2.6.12",
    "crypto-js": "4.1.1",
    "dayjs": "1.8.16",
    "element-ui": "2.15.8",
    "js-cookie": "2.2.1",
    "js-base64": "2.6.4",
    "mobile-detect": "1.4.5",
    "moment": "2.30.1",
    "normalize.css": "8.0.1",
    "nprogress": "0.2.0",
    "sortablejs": "1.15.0",
    "svg-baker-runtime": "1.4.7",
    "vue": "2.6.11",
    "vue-print-nb": "1.7.5",
    "vue-router": "3.2.0",
    "vuedraggable": "2.24.3",
    "vuex": "3.4.0"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "4.5.0",
    "@vue/cli-service": "4.5.0",
    "compression-webpack-plugin": "4.0.0",
    "sass": "1.57.1",
    "sass-loader": "8.0.0",
    "svg-sprite-loader": "4.1.3",
    "vue-template-compiler": "2.6.11"
  }
}
