{
  "name": "@rsh/flow-components",
  "version": "0.1.2",
  "private": false,
  "description": "润世华流程审批组件 - 独立 Web 应用",
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "cross-env NODE_ENV=production VUE_APP_FLAG=prod vue-cli-service build --mode production",
    "build:test": "cross-env NODE_ENV=production VUE_APP_FLAG=test vue-cli-service build --mode test",
    "build:prod": "cross-env NODE_ENV=production VUE_APP_FLAG=prod vue-cli-service build --mode production",
    "sync": "node scripts/sync.js",
    "sync:test": "node scripts/sync.js --env test --write",
    "sync:prod": "node scripts/sync.js --env prod --write",
    "sync:check": "node scripts/sync-check.js",
    "sync:check:test": "node scripts/sync-check.js",
    "sync:check:prod": "node scripts/sync-check.js",
    "publish:flow": "node scripts/publish.js",
    "publish:flow:minor": "node scripts/publish.js --minor",
    "publish:flow:dry": "node scripts/publish.js --dry-run",
    "prebuild": "node scripts/prepare-build.js --env prod",
    "prebuild:prod": "node scripts/prepare-build.js --env prod",
    "prebuild:test": "node scripts/prepare-build.js --env test",
    "postbuild:test": "node scripts/rewrite-test-urls.cjs test"
  },
  "dependencies": {
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^1.0.2",
    "axios": "0.20.0",
    "core-js": "^3.6.5",
    "crypto-js": "4.1.1",
    "dayjs": "1.8.16",
    "element-ui": "2.15.8",
    "js-cookie": "2.2.1",
    "mobile-detect": "^1.4.5",
    "moment": "^2.30.1",
    "normalize.css": "8.0.1",
    "nprogress": "0.2.0",
    "sortablejs": "1.15.0",
    "vue": "2.6.11",
    "vue-json-viewer": "^2.2.22",
    "vue-print-nb": "1.7.5",
    "vue-router": "3.2.0",
    "vuedraggable": "2.24.3",
    "vuex": "3.4.0"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "4.5.0",
    "@vue/cli-service": "4.5.0",
    "compression-webpack-plugin": "4.0.0",
    "cross-env": "^10.1.0",
    "js-base64": "^3.9.4",
    "sass": "1.57.1",
    "sass-loader": "8.0.0",
    "svg-baker-runtime": "^1.4.7",
    "svg-sprite-loader": "4.1.3",
    "vue-template-compiler": "2.6.11"
  },
  "publishConfig": {
    "registry": "http://192.168.1.248:4873/"
  }
}
